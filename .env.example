# Copy this file to ".env" and edit. Everything is optional.

# Folder with your videos. Relative = relative to this project folder; or absolute.
VIDEOS_DIR=videos
# VIDEOS_DIR=D:\Family Movies

# Leave blank to auto-detect VLC
VLC_PATH=
# VLC_PATH=C:\Program Files\VideoLAN\VLC\vlc.exe

# HISTORY_FILE=history.json
# HOST=127.0.0.1
# PORT=8000

# Thumbnails need ffmpeg (auto-detected). Set only if it is not found:
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# THUMBNAILS=true
# THUMB_SECONDS=5
